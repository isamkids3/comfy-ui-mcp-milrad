# ComfyUI Connection
COMFYUI_URL=http://localhost:8188

# ComfyUI Output Storage Directory (Local Disk Path)
COMFYUI_OUTPUT_ROOT=/path/to/comfyui/output

# MCP Security & API Key
MCP_API_KEY=your-secret-api-key

# MCP Server Binding
MCP_HOST=127.0.0.1
MCP_PORT=9000

# Built-in Ngrok Tunnel Development (Laptop)
ENABLE_NGROK=true
# NGROK_AUTHTOKEN=your_ngrok_authtoken_optional
# NGROK_DOMAIN=your-static-name.ngrok-free.app

# Production Deployment (Linux / PGX / Custom Domain)
# Set ENABLE_NGROK=false and specify your public domain URL below:
# ENABLE_NGROK=false
# MCP_PUBLIC_URL=https://mcp.yourcompany.com
