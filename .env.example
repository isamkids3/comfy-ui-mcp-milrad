# ComfyUI Connection (Host machine address on PGX)
# Use http://host.docker.internal:8188 when running inside Docker Compose, or your local LAN IP (e.g., http://192.168.5.245:8188)
COMFYUI_URL=http://host.docker.internal:8188

# ComfyUI Output Storage Directory (Local Disk Path on Host)
# Generated images and videos will be saved here and mounted into the Docker container
COMFYUI_OUTPUT_ROOT=/path/to/local/mcp_images

# MCP Security & API Key (Bearer token for authentication)
MCP_API_KEY=your-secret-api-key-here

# MCP Server Binding
# Set MCP_HOST=0.0.0.0 to accept connections inside Docker
MCP_HOST=0.0.0.0
MCP_PORT=9000

# Cloudflare Tunnel Configuration
# Paste your Cloudflare Tunnel token from Cloudflare Zero Trust Dashboard:
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Public HTTPS Domain URL configured in Cloudflare Tunnel (e.g., https://mcp.yourdomain.com)
MCP_PUBLIC_URL=https://mcp.yourdomain.com
